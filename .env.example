# 네이버 쇼핑 API (https://developers.naver.com 에서 무료 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 어필리에이트 ID (예: 쿠팡 파트너스). 비워두면 원본 링크 반환
AFFILIATE_ID=

# --- 호출 미터링 (per-call) ---
# 서버가 받는 키 목록. 쉼표로 구분하고, 키 안에 쉼표는 넣지 않는다.
# dev-demo-key 는 로컬·PlayMCP 테스트용 예시일 뿐이며 비밀이 아니다.
# 공개 URL에 붙이기 전에 운영자만 아는 키로 바꿀 것. 이 파일을 커밋해도 값은 예시이다.
MCP_API_KEYS=dev-demo-key
# 기본 월간 호출 한도 (UTC 달력 월). 생략하면 1000.
MCP_MONTHLY_QUOTA=1000
# 키별 한도 덮어쓰기. 형식은 키:한도 를 쉼표로 연결. 여기 없는 키는 MCP_MONTHLY_QUOTA.
# MCP_KEY_QUOTAS=dev-demo-key:100
# stdio 전용. 이 로컬 프로세스가 제시하는 키. HTTP 요청에는 적용되지 않는다.
MCP_API_KEY=dev-demo-key
# 사용량 SQLite 파일. 비우면 서버 디렉터리의 usage.db.
# Render 무료 웹 서비스 디스크는 재배포·재시작 때 지워진다.
# MCP_USAGE_DB_PATH=
